package Revisao_LacoFor;

import java.util.Scanner;

public class Desafio_Laco {

	public static void main(String[] args) {
	Scanner scan = new Scanner(System.in);	
	int s = 0;
	int dividendo = 1;
	s = Integer.parseInt(scan.nextLine());
	int divisor;
	divisor = Integer.parseInt(scan.nextLine());
    s = s+ (dividendo/divisor);
    
	for(divisor = 1; divisor <=50; divisor++);
	System.out.println(dividendo + "/" + divisor + " - " + s);
	dividendo = dividendo + 2;
	System.out.println("Sequencia = " + s);
	}

}
