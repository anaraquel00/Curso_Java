 *  Receba o valor em reais como entrada.
 */
String cotacao;
int valor;
System.out.println("Digite a moeda para conversão (1: Dólar, 2: Euro, 3: Libra):");
int codMoeda = scan.nextInt();
System.out.println("Digite o valor em reais (R$):");
double valorReais = scan.nextDouble();
double valorConvertido;

switch (codMoeda) {
case 1:
    valorConvertido = valorReais/5.00;
    System.out.println("O valor em dolares é de: %.2f USD\n"+valorConvertido);
    break;
case 2:
	valorConvertido = valorReais/6.00;
	System.out.println((String.format("O valor em euros é de: %.2f EUR\n",valorConvertido)));
    break;
case 3:
	valorConvertido = valorReais/7.00;
	System.out.println((String.format("O valor em libras é de: %.2f GBP\n", valorConvertido)));
    break;
default:
    System.out.println("Código de moeda inválido!");
    scan.close();
}
}
