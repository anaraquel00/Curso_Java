package métodos;

import java.util.Scanner;

public class switch_estacoes_ano {

	public static void main(String[] args) {
	Scanner scan = new Scanner(System.in);	

	System.out.println("Digite um mês do ano:");
	String mes = scan.nextLine();
	String estacao = null;
	switch (mes) {
	case "dezembro","janeiro","fevereiro" -> estacao = "verao";
	
	case "março","abril","maio" -> estacao = "outono";
	
	case "junho","julho","agosto" -> estacao = "inverno";
	
	case "setembro", "outubro","novembro" -> estacao = "primavera";
	}
	System.out.println("E o mês de "+ estacao);
}
	
}